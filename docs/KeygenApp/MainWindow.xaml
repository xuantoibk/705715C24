<Window x:Class="KeygenApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BXT Keygen (C# port)" Height="480" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#F0F0F0" Padding="10" Margin="0,0,0,10" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Trạng thái bản quyền" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText" Text="Đang kiểm tra..." Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TabControl>
            <!-- Mirrors Key_reg dialog + BXT_checkkey flow: register THIS machine -->
            <TabItem Header="Đăng ký máy này">
                <StackPanel Margin="10">
                    <Label Content="Mã đăng ký (Registration Code) - của máy này"/>
                    <TextBox x:Name="RegCodeBox" IsReadOnly="True" Background="#F5F5F5"/>

                    <Label Content="Mã Key (Registration Key) - dán mã nhận được"/>
                    <TextBox x:Name="RegKeyBox"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Làm mới mã máy" Click="RefreshCode_Click"/>
                        <Button Content="Đăng ký" Click="Register_Click"/>
                        <Button Content="Sao chép mã" Click="CopyCode_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Mirrors Key_gen dialog (bxt_keygen): compute a Key for any Code -->
            <TabItem Header="Công cụ tạo Key">
                <StackPanel Margin="10">
                    <Label Content="Registration Code (nhập hoặc lấy từ máy này)"/>
                    <TextBox x:Name="GenCodeBox"/>

                    <Label Content="Registration Key (kết quả)"/>
                    <TextBox x:Name="GenKeyBox" IsReadOnly="True" Background="#F5F5F5"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Lấy mã máy này" Click="UseLocalCode_Click"/>
                        <Button Content="Generate" Click="Generate_Click"/>
                        <Button x:Name="RegisterFromGenBtn" Content="Đăng ký với Key này" IsEnabled="False" Click="RegisterFromGen_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="GenHintText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="Gray"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
