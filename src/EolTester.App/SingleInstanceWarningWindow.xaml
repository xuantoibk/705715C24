<Window x:Class="EolTester.App.SingleInstanceWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="EOL Tester" Height="165" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontSize="14.3"
        ShowInTaskbar="False" Topmost="True">
    <Viewbox Stretch="Fill">
    <Grid Width="560" Height="165">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="EOL Tester đang chạy rồi — vui lòng đóng cửa sổ cũ trước khi mở lại." TextWrapping="NoWrap"/>
            <TextBlock Text="EOL Tester is already running — please close the existing window first." TextWrapping="NoWrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Button Grid.Row="1" Content="OK" Width="90" Padding="0,6" HorizontalAlignment="Right"
                Click="Ok_Click" IsDefault="True" IsCancel="True"/>
    </Grid>
    </Grid>
    </Viewbox>
</Window>
