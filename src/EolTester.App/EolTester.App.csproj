<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Lõi dùng chung — NuGet package từ feed local D:\NugetLocalFeed (xem ..\..\nuget.config +
         EolTester.Platform\pack.ps1). Core/Communication/Configuration/Data/Security là dependency của
         chính package này, tự flow theo, không cần khai lại. -->
    <PackageReference Include="EolTester.Platform.Wpf" Version="1.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content (không phải Resource) + CopyToOutputDirectory: MainWindow (dùng chung, sống trong
         EolTester.Platform.Wpf.dll) đọc ảnh qua pack://siteoforigin:,,, — ảnh phải là FILE RỜI cạnh exe,
         không được nhúng vào DLL. -->
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 4 file seed ĐÚNG CỦA MÁY NÀY: vừa copy ra SeedData\ cạnh exe, VỪA nhúng vào EolTester.App.dll làm
         bản gốc khôi phục — xem SeedFiles.cs (EolTester.Configuration, dùng chung, tra theo
         Assembly.GetEntryAssembly()). -->
    <EmbeddedResource Include="SeedData\spec-register-map.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SeedData\io-map-seed.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SeedData\spec-Default.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="SeedData\users-seed.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Logo3.ico</ApplicationIcon>
    <!-- App chỉ dùng VI (neutral, trong EolTester.App.dll) + EN (satellite en-US). Chỉ giữ satellite en-US;
         bỏ toàn bộ satellite ngôn ngữ khác của framework WPF (cs/de/tr/zh-Hans/... — chuỗi dịch sẵn của
         PresentationFramework/WindowsBase..., ~8.7 MB, 13 thư mục, không dùng trên máy chạy VN). -->
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
