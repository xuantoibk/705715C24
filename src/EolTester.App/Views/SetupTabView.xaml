<UserControl x:Class="EolTester.App.Views.SetupTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:EolTester.App.Converters"
             xmlns:loc="clr-namespace:EolTester.App.Localization"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1400">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>
    <Grid Margin="16" IsEnabled="{Binding IsAdmin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="518"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== KHỐI TRÁI: Cấu hình kết nối PLC ===== -->
        <Border Grid.Column="0" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="12" VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="620">
                <StackPanel MaxWidth="494">
                    <TextBlock Text="{loc:Tr Setup_Title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,7"/>
                    <TextBlock Text="{loc:Tr Setup_AdminHint}" Foreground="Gray" Margin="0,0,0,7" Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Text="{loc:Tr Setup_RoleChangeRestartHint}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,0,0,7"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Chuẩn truyền thông — tham số chọn ĐẦU TIÊN, Vai trò Master/Slave để chọn sau (bên dưới). -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Setup_Protocol}" VerticalAlignment="Center" Margin="0,4" FontWeight="Bold"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <ComboBox Width="140" ItemsSource="{Binding AvailableProtocols}" SelectedItem="{Binding Protocol}"
                                      ToolTip="{loc:Tr Setup_ProtocolLockedHint}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Setup_RoleDriver}" VerticalAlignment="Center" Margin="0,4"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <ComboBox Width="140" ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding Role}"/>
                        </StackPanel>

                        <!-- ===== Field riêng cho Modbus RTU (serial) ===== -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Setup_ComPort}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsModbusRtu, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4"
                                    Visibility="{Binding IsModbusRtu, Converter={StaticResource BoolToVis}}">
                            <ComboBox Width="140" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding ComPort}"/>
                            <Button Content="{loc:Tr Setup_RefreshPorts}" Command="{Binding RefreshPortsCommand}" Padding="8,2" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Setup_BaudRateParity}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsModbusRtu, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4"
                                    Visibility="{Binding IsModbusRtu, Converter={StaticResource BoolToVis}}">
                            <ComboBox Width="140" ItemsSource="{Binding AvailableBaudRates}" SelectedItem="{Binding BaudRate}"/>
                            <ComboBox Width="140" Margin="10,0,0,0" ItemsSource="{Binding AvailableParities}" SelectedItem="{Binding Parity}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Setup_DataStopBits}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsModbusRtu, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4"
                                    Visibility="{Binding IsModbusRtu, Converter={StaticResource BoolToVis}}">
                            <ComboBox Width="70" ItemsSource="{Binding AvailableDataBits}" SelectedItem="{Binding DataBits}"/>
                            <ComboBox Width="70" Margin="10,0,0,0" ItemsSource="{Binding AvailableStopBits}" SelectedItem="{Binding StopBits}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Tr Setup_StationAddress}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsModbusMasterMode, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding StationAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
                                 Visibility="{Binding IsModbusMasterMode, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Tr Setup_MySlaveId}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsModbusSlaveMode, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MySlaveId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
                                 Visibility="{Binding IsModbusSlaveMode, Converter={StaticResource BoolToVis}}"/>

                        <!-- ===== Field riêng cho MC Protocol/SLMP (Ethernet/TCP) ===== -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Setup_IpAddress}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsMcOrSlmp, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Width="140" HorizontalAlignment="Left"
                                 Visibility="{Binding IsMcOrSlmp, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Setup_Port}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsMcOrSlmp, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Width="140" HorizontalAlignment="Left"
                                 Visibility="{Binding IsMcOrSlmp, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Setup_McFrameFormat}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsMcProtocol, Converter={StaticResource BoolToVis}}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,4"
                                  ItemsSource="{Binding AvailableMcFrameFormats}" SelectedItem="{Binding McFrameFormat}"
                                  Visibility="{Binding IsMcProtocol, Converter={StaticResource BoolToVis}}"/>

                        <!-- ===== Field dùng chung mọi giao thức (chỉ khác theo Role) ===== -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Tr Setup_PollingInterval}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsMasterMode, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding PollingIntervalMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"
                                 Visibility="{Binding IsMasterMode, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Tr Setup_TimeoutRetry}" VerticalAlignment="Center" Margin="0,4"
                                   Visibility="{Binding IsMasterMode, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,4"
                                    Visibility="{Binding IsMasterMode, Converter={StaticResource BoolToVis}}">
                            <TextBox Width="80" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{loc:Tr Setup_Ms}" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBox Width="60" Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{loc:Tr Setup_Times}" Margin="6,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Visibility="{Binding IsMasterMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Tr Setup_RegisterBlockTitle}" FontSize="14" FontWeight="Bold" Margin="0,12,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Setup_InputBlock}" VerticalAlignment="Center" Margin="0,4" FontWeight="Bold"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="D" VerticalAlignment="Center"/>
                                <TextBox Width="70" Text="{Binding InputBlockStartAddress, UpdateSourceTrigger=PropertyChanged}" Margin="2,0,10,0"/>
                                <TextBlock Text="{loc:Tr Setup_RegisterCount}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="60" Text="{Binding InputBlockRegisterCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InputRegisterCountWarning}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,2,0,4"
                                       Visibility="{Binding InputRegisterCountWarning, Converter={StaticResource StringToVis}}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Setup_OutputBlock}" VerticalAlignment="Center" Margin="0,4" FontWeight="Bold"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="D" VerticalAlignment="Center"/>
                                <TextBox Width="70" Text="{Binding OutputBlockStartAddress, UpdateSourceTrigger=PropertyChanged}" Margin="2,0,10,0"/>
                                <TextBlock Text="{loc:Tr Setup_RegisterCount}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Width="60" Text="{Binding OutputBlockRegisterCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OutputRegisterCountWarning}" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding OutputRegisterCountWarning, Converter={StaticResource StringToVis}}"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{loc:Tr Setup_SlaveModeHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding IsSlaveMode, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:Tr Setup_SaveConfig}" Command="{Binding SaveCommand}" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="{loc:Tr Setup_TestConnection}" Command="{Binding TestConnectionCommand}" Padding="10,4"
                                Visibility="{Binding IsMasterMode, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="DarkGreen"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== KHỐI PHẢI: Giám sát DATA — lưới cố định 2 cột × 12 dòng, không hint text (màn hình khách hàng) ===== -->
        <Border Grid.Column="2" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="12" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Tr Setup_RegisterWatchTitle}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid Grid.Column="0" ItemsSource="{Binding RegisterWatchColumn1}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeight="26" ColumnHeaderHeight="30" Margin="0,0,10,0" VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr Setup_RegisterWatchColAddress}" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="{loc:Tr Setup_RegisterWatchColCurrentValue}" Binding="{Binding CurrentValueDisplay}" Width="80"/>
                            <DataGridTemplateColumn Header="{loc:Tr Setup_RegisterWatchColDisplayFormat}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox BorderThickness="0" Background="Transparent"
                                                  ItemsSource="{Binding DataContext.AvailableDisplayFormats, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Tr Setup_RegisterWatchColDataType}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox BorderThickness="0" Background="Transparent"
                                                  ItemsSource="{Binding DataContext.AvailableDataTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding ValidationMessage}"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <DataGrid Grid.Column="1" ItemsSource="{Binding RegisterWatchColumn2}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" RowHeight="26" ColumnHeaderHeight="30" VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Tr Setup_RegisterWatchColAddress}" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="{loc:Tr Setup_RegisterWatchColCurrentValue}" Binding="{Binding CurrentValueDisplay}" Width="80"/>
                            <DataGridTemplateColumn Header="{loc:Tr Setup_RegisterWatchColDisplayFormat}" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox BorderThickness="0" Background="Transparent"
                                                  ItemsSource="{Binding DataContext.AvailableDisplayFormats, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DisplayFormat, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Tr Setup_RegisterWatchColDataType}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox BorderThickness="0" Background="Transparent"
                                                  ItemsSource="{Binding DataContext.AvailableDataTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding ValidationMessage}"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
