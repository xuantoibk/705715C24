<UserControl x:Class="EolTester.App.Views.MainTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:EolTester.App.Converters;assembly=EolTester.Platform.Wpf"
             xmlns:loc="clr-namespace:EolTester.App.Localization;assembly=EolTester.Platform.Wpf"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1400">
    <UserControl.Resources>
        <conv:PassedToBrushConverter x:Key="PassedToBrush"/>
        <conv:OkNgToBrushConverter x:Key="OkNgToBrush"/>
        <conv:OkNgToTextConverter x:Key="OkNgToText" Placeholder=""/>
        <conv:OkNgToTextConverter x:Key="OkNgToTextDash" Placeholder="--"/>

        <!-- Cột "Giá trị": bước đo số bình thường hiện số + màu Pass/Fail như cũ; bước kiểu kiểm tra tín
             hiệu (IsConfigured=False, VD "Kiểm tra LED 1") hiện trực tiếp OK/NG theo quy ước dùng chung
             (trắng/cam). Dùng chung cho cả 2 bảng High/Low mode để không lặp lại template. -->
        <DataTemplate x:Key="ValueCellTemplate">
            <Border Padding="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding Passed, Converter={StaticResource PassedToBrush}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                <Setter Property="Background" Value="{Binding OkNgResult, Converter={StaticResource OkNgToBrush}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" Foreground="Black">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding MeasuredValueDisplayText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConfigured}" Value="False">
                                    <Setter Property="Text" Value="{Binding OkNgResult, Converter={StaticResource OkNgToTextDash}}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!-- Cột "OK / NG" bổ sung: hiện với MỌI bước đã cấu hình OkNgAddress (đo số lẫn kiểm tra tín hiệu),
             cùng quy ước màu như trên; trống nếu bước chưa gán thanh ghi OK/NG. -->
        <DataTemplate x:Key="OkNgCellTemplate">
            <Border Background="{Binding OkNgResult, Converter={StaticResource OkNgToBrush}}" Padding="2">
                <TextBlock Text="{Binding OkNgResult, Converter={StaticResource OkNgToText}}" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Black"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Trái: bảng kết quả bước kiểm tra (chỉ đọc). Khối "Kết quả" OK/NG tổng hợp đã chuyển sang cột giữa,
             ngay dưới dòng "Có Sản phẩm" (theo yêu cầu người dùng). -->
        <StackPanel Grid.Column="0" Margin="4">
        <StackPanel x:Name="TestTablesPanel">
            <TextBlock Text="{loc:Tr Main_HighMode}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <DataGrid ItemsSource="{Binding HighModeConfiguredSteps}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr Main_Description}" Binding="{Binding Description}" Width="2*"/>
                    <DataGridTextColumn Header="{loc:Tr Main_LowerLimit}" Binding="{Binding LowerLimitDisplayText}" Width="*"/>
                    <DataGridTemplateColumn Header="{loc:Tr Main_Value}" Width="*" CellTemplate="{StaticResource ValueCellTemplate}"/>
                    <DataGridTextColumn Header="{loc:Tr Main_UpperLimit}" Binding="{Binding UpperLimitDisplayText}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Tr Main_Unit}" Binding="{Binding Unit}" Width="60"/>
                    <DataGridTemplateColumn Header="{loc:Tr Main_OkNg}" Width="70" CellTemplate="{StaticResource OkNgCellTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{loc:Tr Main_LowMode}" FontWeight="Bold" FontSize="14" Margin="0,12,0,4"/>
            <DataGrid ItemsSource="{Binding LowModeConfiguredSteps}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr Main_Description}" Binding="{Binding Description}" Width="2*"/>
                    <DataGridTextColumn Header="{loc:Tr Main_LowerLimit}" Binding="{Binding LowerLimitDisplayText}" Width="*"/>
                    <DataGridTemplateColumn Header="{loc:Tr Main_Value}" Width="*" CellTemplate="{StaticResource ValueCellTemplate}"/>
                    <DataGridTextColumn Header="{loc:Tr Main_UpperLimit}" Binding="{Binding UpperLimitDisplayText}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Tr Main_Unit}" Binding="{Binding Unit}" Width="60"/>
                    <DataGridTemplateColumn Header="{loc:Tr Main_OkNg}" Width="70" CellTemplate="{StaticResource OkNgCellTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bảng "Kiểm tra khác": các bước kiểu OK/NG thuần (Kiểm tra led / MMT Quay / Chiều quay MMT) —
                 không có giới hạn số, cột "Giá trị" hiện trực tiếp OK/NG (xem ValueCellTemplate, nhánh
                 IsConfigured=False). "MMT Quay" = Low.led2/D66, "Chiều quay MMT" = High.mmtDir/D69. -->
            <TextBlock Text="{loc:Tr Main_OtherChecks}" FontWeight="Bold" FontSize="14" Margin="0,12,0,4"/>
            <DataGrid ItemsSource="{Binding OtherCheckSteps}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" MaxHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Tr Main_Description}" Binding="{Binding Description}" Width="2*"/>
                    <DataGridTextColumn Header="{loc:Tr Main_LowerLimit}" Binding="{Binding LowerLimitDisplayText}" Width="*"/>
                    <DataGridTemplateColumn Header="{loc:Tr Main_Value}" Width="*" CellTemplate="{StaticResource ValueCellTemplate}"/>
                    <DataGridTextColumn Header="{loc:Tr Main_UpperLimit}" Binding="{Binding UpperLimitDisplayText}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Tr Main_Unit}" Binding="{Binding Unit}" Width="60"/>
                    <DataGridTemplateColumn Header="{loc:Tr Main_OkNg}" Width="70" CellTemplate="{StaticResource OkNgCellTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        </StackPanel>

        <!-- Giữa: tín hiệu LED + cảm biến phát hiện sản phẩm (bit Dxxxx.Y, spec-register-map.csv), rồi khối
             "Kết quả" tổng hợp ngay bên dưới dòng "Có Sản phẩm" (theo yêu cầu người dùng — trước đây nằm ở
             cột trái dưới bảng bước kiểm tra). Border tín hiệu tự co theo nội dung (bỏ ràng buộc Height theo
             TestTablesPanel) để "Kết quả" bám sát ngay sau hàng sensor. -->
        <StackPanel Grid.Column="1" Margin="8" VerticalAlignment="Top">
        <Border Padding="8" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1">
            <StackPanel Width="220">
                <TextBlock Text="{loc:Tr Main_LedSignalHeader}" FontWeight="Bold" Margin="0,0,0,8"/>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Tr Main_Led1}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="48" Height="24" BorderBrush="Orange" BorderThickness="2" Background="{Binding Led1.Value, Converter={x:Static conv:StaticConverters.OnOffBrush}}"/>
                </Grid>
                <Grid Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Tr Main_Led2}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="48" Height="24" BorderBrush="Orange" BorderThickness="2" Background="{Binding Led2.Value, Converter={x:Static conv:StaticConverters.OnOffBrush}}"/>
                </Grid>
                <Grid Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Tr Main_Led3}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="48" Height="24" BorderBrush="Orange" BorderThickness="2" Background="{Binding Led3.Value, Converter={x:Static conv:StaticConverters.OnOffBrush}}"/>
                </Grid>

                <TextBlock Text="{loc:Tr Main_SensorHeader}" FontWeight="Bold" Margin="0,16,0,8"/>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Tr Main_ProductDetected}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Width="48" Height="24" BorderBrush="Orange" BorderThickness="2" Background="{Binding ProductDetected.Value, Converter={x:Static conv:StaticConverters.OnOffBrush}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Kết quả tổng hợp — cùng thanh ghi SIGNAL_NG_DETECTED (D71) với ô "PHÁT HIỆN HÀNG NG" ở footer
             (MainTabViewModel.NgDetected trỏ chung PlcPollingService.NgDetected, tự đồng bộ). 0/null = ẩn ảnh
             (khung trống), 1 = ok.png, 2 = ng.png. Ảnh phóng to (~190px) theo yêu cầu người dùng. -->
        <TextBlock Text="{loc:Tr Main_ResultHeader}" FontWeight="Bold" FontSize="18" Foreground="#CA8A04" Margin="0,16,0,8"/>
        <Border Width="190" Height="190" BorderBrush="Red" BorderThickness="2" HorizontalAlignment="Left" Background="White">
            <Image Stretch="Uniform" Margin="6">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NgDetected.Value}" Value="1">
                                <Setter Property="Source" Value="/Assets/ok.png"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding NgDetected.Value}" Value="2">
                                <Setter Property="Source" Value="/Assets/ng.png"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Border>
        </StackPanel>

        <!-- Phải: logo + lịch sử thông báo -->
        <StackPanel Grid.Column="2" Margin="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border Width="210" Height="110" Padding="6">
                    <Image Source="/Assets/Logo1.png" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <TextBlock Text="{loc:Tr Main_NotificationHistory}" FontWeight="Bold" Margin="0,8,0,4"/>
            <ListBox ItemsSource="{Binding DataContext.NotificationHistory, RelativeSource={RelativeSource AncestorType=Window}}" Height="300"/>
        </StackPanel>
    </Grid>
</UserControl>
