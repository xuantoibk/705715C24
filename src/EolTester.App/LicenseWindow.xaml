<Window x:Class="EolTester.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:EolTester.App.Localization;assembly=EolTester.Platform.Wpf"
        mc:Ignorable="d"
        Title="{loc:Tr License_Title}" Height="360" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,4,0,14"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Fill">
    <Grid Width="520" Height="360">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Tr License_NotRegistered}" FontWeight="Bold" FontSize="15" Foreground="#B3261E" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#5B6479" Text="{loc:Tr License_Instruction}"/>

        <TextBlock Grid.Row="2" Text="{loc:Tr License_RegCodeLabel}" Margin="0,12,0,0" FontWeight="Bold"/>
        <TextBox Grid.Row="3" Text="{Binding RegistrationCode, Mode=OneWay}" IsReadOnly="True" Background="#F5F5F5"/>

        <StackPanel Grid.Row="4">
            <TextBlock Text="{loc:Tr License_RegKeyLabel}" FontWeight="Bold"/>
            <TextBox Text="{Binding EnteredKey, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Tr License_Exit}" Click="Exit_Click" Margin="0,0,8,0"/>
            <Button Content="{loc:Tr License_Register}" Command="{Binding RegisterCommand}" Background="LightGreen" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
    </Grid>
    </Viewbox>
</Window>
