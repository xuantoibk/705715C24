<Window x:Class="EolTester.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EolTester.App"
        xmlns:views="clr-namespace:EolTester.App.Views"
        xmlns:conv="clr-namespace:EolTester.App.Converters"
        xmlns:loc="clr-namespace:EolTester.App.Localization"
        xmlns:b="clr-namespace:EolTester.App.Behaviors"
        mc:Ignorable="d"
        Title="EOL Tester - 705/715" MinHeight="699" MinWidth="1280"
        Icon="/Assets/Logo3.png"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:ConnectionStateToBrushConverter x:Key="ConnStateToBrush"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <conv:IndexToVisibilityConverter x:Key="IndexToVis"/>
        <conv:RunningToBrushConverter x:Key="RunningToBrush"/>
        <conv:NgValueToBrushConverter x:Key="NgValueToBrush"/>
        <conv:EnumEqualsToBrushConverter x:Key="LangActiveBrush"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <Style x:Key="LangFlagButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style x:Key="JobFieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,10,3"/>
        </Style>
        <Style x:Key="FooterCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8B93A7"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ScanFieldCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8B93A7"/>
        </Style>
        <!-- Cỡ chữ 27 (18 * 1.5) — tăng 50% so với trước, chữ đen đậm rõ ràng cho cả 2 ô "Mã Scan quét
             được"/"Mã Scan ghi nhận" (ô sau IsReadOnly=True vẫn cần Foreground tường minh, không để WPF tự ý
             làm mờ chữ theo style mặc định của TextBox chỉ-đọc). -->
        <Style x:Key="ScanFieldBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="BorderBrush" Value="#C7CCD6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ConfirmNgButton" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="LimeGreen"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Fill">
    <Grid Width="1400" Height="765">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER: tiêu đề, trạng thái kết nối, tab, đăng nhập/đăng xuất ===== -->
        <Border Grid.Row="0" Background="#1F2937" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Logo1.png" Stretch="Uniform" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr Header_Title}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" TextTrimming="CharacterEllipsis"/>
                    <Ellipse Width="12" Height="12" Fill="{Binding ConnectionState, Converter={StaticResource ConnStateToBrush}}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStateText}" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- TabControl khóa không wrap: mỗi header bọc TextBlock TextWrapping="NoWrap" tường minh —
                     tránh tự động xuống dòng thành 2 hàng khi cột 2 (đăng nhập) rộng ra bất ngờ (VD lỗi đăng
                     nhập trước đây hiện text dài ngay trong hàng header, nay đã chuyển sang lịch sử thông báo). -->
                <TabControl Grid.Column="1" x:Name="MainTabControl" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Margin="20,0" HorizontalAlignment="Center">
                    <TabItem>
                        <TabItem.Header><TextBlock Text="{loc:Tr Header_Tab_Main}" TextWrapping="NoWrap"/></TabItem.Header>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header><TextBlock Text="{loc:Tr Header_Tab_Monitor}" TextWrapping="NoWrap"/></TabItem.Header>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header><TextBlock Text="{loc:Tr Header_Tab_Setup}" TextWrapping="NoWrap"/></TabItem.Header>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header><TextBlock Text="{loc:Tr Header_Tab_Setting}" TextWrapping="NoWrap"/></TabItem.Header>
                    </TabItem>
                </TabControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}">
                    <ComboBox x:Name="LoginUserNameBox" Width="110" Margin="4,0" IsEditable="False" IsSynchronizedWithCurrentItem="False"
                              ItemsSource="{Binding AvailableUserNames}"
                              SelectedItem="{Binding LoginUserName, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{loc:Tr Header_LoginUserTooltip}"/>
                    <PasswordBox x:Name="LoginPasswordBox" Width="110" Margin="4,0" PasswordChanged="LoginPasswordBox_PasswordChanged" ToolTip="{loc:Tr Header_LoginPasswordTooltip}"/>
                    <Button Content="{loc:Tr Header_Login}" Command="{Binding LoginCommand}" Padding="8,2" Margin="4,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                    <TextBlock Foreground="White" VerticalAlignment="Center" Margin="4,0">
                        <Run Text="{Binding CurrentUser.UserName, Mode=OneWay}"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding CurrentUser.Role, Mode=OneWay}"/>
                        <Run Text=")"/>
                    </TextBlock>
                    <Button Content="{loc:Tr Header_Logout}" Command="{Binding LogoutCommand}" Padding="8,2" Margin="4,0"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource LangFlagButton}" Command="{Binding SetLanguageCommand}" CommandParameter="0"
                            BorderBrush="{Binding CurrentLanguageIndex, Converter={StaticResource LangActiveBrush}, ConverterParameter=0}" ToolTip="Tiếng Việt">
                        <Image Source="/Assets/VI.png" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource LangFlagButton}" Command="{Binding SetLanguageCommand}" CommandParameter="1"
                            BorderBrush="{Binding CurrentLanguageIndex, Converter={StaticResource LangActiveBrush}, ConverterParameter=1}" ToolTip="English">
                        <Image Source="/Assets/EN.png" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== NỘI DUNG TAB ===== -->
        <Grid Grid.Row="1" Margin="8">
            <views:MainTabView DataContext="{Binding MainTab}" Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVis}, ConverterParameter=0}"/>
            <views:MonitorTabView DataContext="{Binding MonitorTab}" Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVis}, ConverterParameter=1}"/>
            <views:SetupTabView DataContext="{Binding SetupTab}" Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVis}, ConverterParameter=2}"/>
            <views:SettingTabView DataContext="{Binding SettingTab}" Visibility="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVis}, ConverterParameter=3}"/>
        </Grid>

        <!-- ===== FOOTER: 1 khối chữ nhật gồm Thông tin Lot | Trạng thái | (Scan Barcode + Operation) ===== -->
        <Border Grid.Row="2" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,1,0,0" Padding="8">
            <Border MinHeight="150" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cột 1: THÔNG TIN LOT — nội dung ở hàng trên, "XÁC NHẬN JOB" là chuẩn căn cho hàng hành động dưới cùng -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Tr Footer_LotInfo}" Style="{StaticResource FooterCardTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Footer_Model}" Style="{StaticResource JobFieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Footer_Date}" Style="{StaticResource JobFieldLabel}"/>
                            <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding LotDate}" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Footer_Job}" Style="{StaticResource JobFieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Tr Footer_JobId}" Style="{StaticResource JobFieldLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConfirmedJobId}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfirmedJobId}"/>
                        </Grid>
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="0" Margin="0,10,16,0" Content="{loc:Tr Footer_ConfirmJob}" Command="{Binding ConfirmJobCommand}"
                            IsEnabled="{Binding IsLoggedIn}"
                            Padding="6,4" MinHeight="38" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <Rectangle Grid.Column="0" Grid.RowSpan="2" Width="1" Fill="#D1D5DB" HorizontalAlignment="Right" Margin="0,0,-8,0"/>

                    <!-- Cột 2: TRẠNG THÁI — "PHÁT HIỆN HÀNG NG" giãn cao lấp khoảng trống khi nút xác nhận chuyển xuống hàng dưới -->
                    <Grid Grid.Row="0" Grid.Column="1" Margin="16,0,16,0" Width="190">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Tr Footer_Status}" Style="{StaticResource FooterCardTitle}"/>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="{loc:Tr Footer_CycleTime}" Style="{StaticResource ScanFieldCaption}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding CycleTime, StringFormat={}{0:hh\\:mm\\:ss}}" FontSize="33" FontWeight="Bold" Foreground="Black" FontFamily="Consolas" Margin="0,0,0,10"/>
                        </StackPanel>

                        <Border Grid.Row="2" Padding="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="3"
                                Background="{Binding NgDetected.Value, Converter={StaticResource NgValueToBrush}}">
                            <TextBlock Text="{Binding NgStatusText}" Foreground="Black" FontWeight="Bold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                    <Button Grid.Row="1" Grid.Column="1" Margin="16,10,16,0" Content="{loc:Tr Footer_ConfirmNg}"
                            b:MomentaryButton.PressCommand="{Binding ConfirmNgPressCommand}" b:MomentaryButton.ReleaseCommand="{Binding ConfirmNgReleaseCommand}"
                            IsEnabled="{Binding CanSendCommands}"
                            Padding="6,4" MinHeight="38" Style="{StaticResource ConfirmNgButton}" FontWeight="Bold"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                    <Rectangle Grid.Column="1" Grid.RowSpan="2" Width="1" Fill="#D1D5DB" HorizontalAlignment="Right" Margin="0,0,-8,0"/>

                    <!-- Cột 3: SCAN BARCODE ở hàng trên, OPERATION nằm trong hàng hành động dưới cùng, cùng hàng với 2 nút bên trái -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="16,0,0,0">
                        <TextBlock Text="{loc:Tr Footer_ScanBarcode}" Style="{StaticResource FooterCardTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:Tr Footer_ScanInput}" Style="{StaticResource ScanFieldCaption}"/>
                                <!-- IsReadOnly theo SettingTab.AllowEditBarcode (PARAM_EDIT_SCAN, D104.0): false — chỉ đầu đọc
                                     mới ghi được (gõ tay bị chặn), true — cho phép gõ tay + Enter như bình thường. Đầu đọc
                                     ghi thẳng vào ScanBarcodeText qua KeyboardWedgeScanCapture (bypass IsReadOnly, xem class
                                     đó) nên vẫn hoạt động đúng ở cả 2 trạng thái. -->
                                <TextBox x:Name="ScanInputBox" Text="{Binding ScanBarcodeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ScanFieldBox}"
                                         IsReadOnly="{Binding SettingTab.AllowEditBarcode, Converter={StaticResource InverseBool}}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding CommitScanCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{loc:Tr Footer_ScanRecognized}" Style="{StaticResource ScanFieldCaption}"/>
                                <TextBox Text="{Binding LastScanOk}" IsReadOnly="True" Style="{StaticResource ScanFieldBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="2" Margin="16,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Tr Footer_Operation}" Style="{StaticResource FooterCardTitle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding OperationStatusText}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="{Binding StartButtonLabel}" Command="{Binding StartCommand}" IsEnabled="{Binding CanSendCommands}" VerticalAlignment="Stretch" Margin="8,0,0,0" Padding="18,5" FontWeight="Bold" FontSize="15" MinWidth="88" MinHeight="38" Background="{Binding IsRunning, Converter={StaticResource RunningToBrush}}"/>
                        <Button Grid.Column="3" Content="{loc:Tr Footer_Reset}" b:MomentaryButton.PressCommand="{Binding ResetPressCommand}" b:MomentaryButton.ReleaseCommand="{Binding ResetReleaseCommand}" IsEnabled="{Binding CanSendCommands}" VerticalAlignment="Stretch" Margin="8,0,0,0" Padding="13,5" FontWeight="Bold" FontSize="15" MinWidth="70" MinHeight="38" Background="LightSalmon"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
    </Viewbox>
</Window>
