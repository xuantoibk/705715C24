<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EolTester.Core\EolTester.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Ghim thẳng bản native SQLite đã vá CVE-2025-6965 (NU1903, CVSS 7.2 — memory corruption) — Microsoft.Data.Sqlite
         10.0.9 vẫn kéo theo SQLitePCLRaw.lib.e_sqlite3 2.1.11 (native SQLite < 3.50.2, chưa vá). 3.50.3 chỉ nâng bản
         native binary, vẫn tương thích phần managed 2.x mà Microsoft.Data.Sqlite dùng. Gỡ override này khi
         Microsoft.Data.Sqlite tự nâng bản patched làm mặc định. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
